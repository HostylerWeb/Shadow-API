{
  "manifest_version": 3,
  "name": "Chrome Agent Bridge",
  "version": "0.1.25",
  "description": "Connects your Chrome to a local AI/MCP bridge (no remote debugging).",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "debugger", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Chrome Agent Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
