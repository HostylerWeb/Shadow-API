# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000

# PostgreSQL
# Default host ports match docker-compose (5433 / 6380) to avoid clashing with local Postgres/Redis.
DATABASE_URL=postgres://shadowapi:shadowapi@localhost:5433/shadowapi

# Redis (queue + cache + locks)
REDIS_URL=redis://localhost:6380

# S3-compatible (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=shadowapi-artifacts
S3_FORCE_PATH_STYLE=true

# Worker
WORKER_CONCURRENCY=2
