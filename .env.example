# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000

# PostgreSQL
# Default host ports match docker-compose (5433 / 6380) to avoid clashing with local Postgres/Redis.
DATABASE_URL=postgres://shadowapi:shadowapi@localhost:5433/shadowapi

# Redis (queue + cache + locks)
REDIS_URL=redis://localhost:6380

# S3-compatible (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=shadowapi-artifacts
S3_FORCE_PATH_STYLE=true

# Worker
WORKER_CONCURRENCY=2

# AES-256-GCM key for vault ciphertext (32 bytes, base64). Local stand-in for KMS.
VAULT_DATA_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# Portal session cookie (httpOnly). Not an API key.
PORTAL_SESSION_SECRET=dev-portal-session-secret

# Optional platform admin created by pnpm db:seed
# ADMIN_EMAIL=admin@localhost
# ADMIN_PASSWORD=password-123

# Gateway the portal calls when you run a job from the dashboard
GATEWAY_URL=http://localhost:3000
