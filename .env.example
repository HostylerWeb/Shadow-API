# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000

# PostgreSQL
# Default host ports match docker-compose (5436 / 6382) to avoid clashing with local Postgres/Redis.
DATABASE_URL=postgres://shadowapi:shadowapi@localhost:5436/shadowapi

# Redis (queue + cache + locks)
REDIS_URL=redis://localhost:6382

# S3-compatible (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=shadowapi-artifacts
S3_FORCE_PATH_STYLE=true

# Worker
WORKER_CONCURRENCY=2
# Directory with camoufox-bin and version.json. Run `camoufox fetch` from apps/worker if this is unset.
# CAMOUFOX_INSTALL_DIR=
# Base URL for carrier_x_pod staging mirror (serve connectors/carrier_x_pod/staging/ or use file:// in tests)
# STAGING_ORIGIN=http://127.0.0.1:8765

# Optional metrics protection (gateway GET /v1/metrics)
# METRICS_TOKEN=

# Optional portal users (pnpm db:seed-portal)
# PORTAL_ADMIN_EMAIL=admin@localhost
# PORTAL_ADMIN_PASSWORD=change-me
# PORTAL_CUSTOMER_EMAIL=customer@localhost
# PORTAL_CUSTOMER_PASSWORD=change-me

# Extra teach browse hosts (comma-separated); record flow also sets teach_allow_hosts cookie
# TEACH_BROWSE_ALLOWLIST=

# Embedded Camoufox studio (apps/studio-browser)
STUDIO_BROWSER_URL=http://localhost:3020
STUDIO_BROWSER_SECRET=dev-studio-browser-secret

# AES-256-GCM key for vault ciphertext (32 bytes, base64). Local stand-in for KMS.
VAULT_DATA_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# Portal session cookie (httpOnly). Not an API key.
PORTAL_SESSION_SECRET=dev-portal-session-secret

# Optional platform admin created by pnpm db:seed
# ADMIN_EMAIL=admin@localhost
# ADMIN_PASSWORD=password-123

# Gateway the portal calls when you run a job from the dashboard
GATEWAY_URL=http://localhost:3000
